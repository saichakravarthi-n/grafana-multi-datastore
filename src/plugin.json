{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Multi Datastore",
  "id": "ucn-multidatastore-datasource",
  "metrics": true,
  "info": {
    "description": "Run MySQL, PostgreSQL, and SQL Server queries in dependency order, and pass column values from one query into the next.",
    "author": {
      "name": "ucn"
    },
    "keywords": ["mysql", "postgresql", "sql server", "sql"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "GitHub",
        "url": "https://github.com/saichakravarthi-n/grafana-multi-datastore"
      }
    ],
    "screenshots": [
      {
        "name": "Orders for active users",
        "path": "img/orders.png"
      },
      {
        "name": "Query editor",
        "path": "img/query-editor.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=13.2.0",
    "plugins": []
  }
}
