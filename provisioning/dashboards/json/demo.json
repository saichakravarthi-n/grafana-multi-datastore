  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Orders for active users",
      "description": "MySQL returns active user ids. PostgreSQL then loads orders whose user_id is in that list.",
      "datasource": { "type": "ucn-multidatastore-datasource", "uid": "multidatastore" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "ucn-multidatastore-datasource", "uid": "multidatastore" },
          "steps": [
            {
              "id": "users",
              "datasourceUid": "mysql",
              "datasourceType": "mysql",
              "rawSql": "SELECT id FROM users WHERE active = 1 ORDER BY id",
              "hide": true
            },
            {
              "id": "orders",
              "datasourceUid": "postgres",
              "datasourceType": "postgres",
              "rawSql": "SELECT id, user_id, sku FROM orders WHERE user_id IN ({{users.id}}) ORDER BY id",
              "hide": false
            }
          ]
        }
      ]
    },
    {
